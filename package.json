{
  "name": "forge",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise-grade AI Desktop IDE with local model runtime, Subhash UI/UX design system, Ponytail, and REA integration",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"import('fs').then(f => { f.writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'})); f.copyFileSync('electron/voiceDictation.ps1', 'dist-electron/voiceDictation.ps1'); })\"",
    "build:all": "npm run build && npm run build:electron",
    "electron:dev": "npm run build && npm run build:electron && electron .",
    "test": "vitest run",
    "test:skills": "node --test skills/security-audit/validate-findings.test.cjs skills/security-audit/validate-coverage-ledger.test.cjs",
    "test:all": "npm test && npm run test:skills",
    "start": "electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "p5": "^1.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/p5": "^1.7.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
